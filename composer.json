{
    "name": "repeater-field-for-acf/repeater-field-for-acf",
    "description": "ACF Repeater field for Advanced Custom Fields (Free version)",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "composer/installers": "^2.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "wp-coding-standards/wpcs": "^3.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ACF_Repeater\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ACF_Repeater\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        },
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse includes tests/php",
        "phpcs": "phpcs --standard=WordPress --extensions=php includes tests/php",
        "phpcbf": "phpcbf --standard=WordPress --extensions=php includes tests/php",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}